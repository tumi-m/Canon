# copy to .env.local. never commit the real values — .env* is gitignored.
# nothing here is required: without the supabase pair the app runs on seed
# data with accounts switched off, and says so.

# supabase — accounts switch on when both of these are set (read at build time,
# so set them in vercel and redeploy). the key is the public anon/publishable one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY on newer projects
SUPABASE_SERVICE_ROLE_KEY=        # server only. NEVER in a client component. not used yet.
# optional: pin the address providers send people back to (else the request's host)
NEXT_PUBLIC_SITE_URL=

# the row level security suite: any postgres server it may create a database on
RLS_DATABASE_URL=                 # e.g. postgresql://postgres:postgres@localhost:5432/postgres

# availability (M4)
TMDB_API_KEY=

# payments (M7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# cache / email / analytics
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
