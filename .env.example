# availability (M4)
TMDB_API_KEY=

# payments (M7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# cache / email / analytics
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
